  "scene_actions": [
    {
      "key": "get_status",
      "label": {
        "en": "State of authentik",
        "fr": "État d'authentik",
        "de": "Zustand von authentik",
        "es": "Estado de authentik"
      },
      "description": {
        "en": "Sums up authentik for a message: failed and successful logins, outposts, and a ready-made sentence.",
